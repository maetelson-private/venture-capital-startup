# 복사해서 .env 로 저장 후 값 입력. 키가 없는 소스는 건너뜀
# 발급 방법은 README.md 'API 키 발급' 참고

# ── 공공데이터포털 (data.go.kr) ─────────────────────────────
# 키 하나로 여러 API 를 쓰지만, API 마다 '활용신청'은 따로 해야 함
#   1단계·5단계  국민연금공단_국민연금 가입 사업장 내역
#   2단계        창업진흥원_K-Startup 사업공고·선정 조회
#   4단계        식품의약품안전처_의료기기 품목허가 정보 / 의료기기 임상시험 승인
#   기본 정보    국세청_사업자등록정보 진위확인 및 상태조회 서비스
DATA_GO_KR_KEY=        # 마이페이지 > 개발계정의 '일반 인증키(Decoding)'

# ── 1단계: 연구 ─────────────────────────────────────────────
KIPRIS_KEY=            # plus.kipris.or.kr: 특허 출원인·발명자 검색 (대학 산학협력단 → 신생 법인 추적)
NTIS_KEY=              # ntis.go.kr: 국가R&D 과제 수행기관

# ── 기본 정보·결산 ──────────────────────────────────────────
DART_KEY=              # opendart.fss.or.kr: 기업개황·결산

# ── 6단계: 노출 (뉴스) ──────────────────────────────────────
NAVER_CLIENT_ID=       # developers.naver.com 검색 API. 없으면 구글뉴스 RSS(제목만) 사용
NAVER_CLIENT_SECRET=

# ── 추출 보조 (선택) ────────────────────────────────────────
ANTHROPIC_API_KEY=     # console.anthropic.com: 기사 본문, HWP·PDF 공고 명단을 칸별 JSON 으로 추출
